#!/usr/bin/env python3
"""Render a Venera user service using deployment paths."""
import argparse
from pathlib import Path


def quoted(value):
    value = str(value)
    if any(ord(c) < 32 or ord(c) == 127 for c in value):
        raise ValueError("deployment paths must contain printable characters")
    return '"' + value.replace('\\', '\\\\').replace('"', '\\"').replace('%', '%%').replace('$', '$$') + '"'


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--binary', required=True, type=Path)
    parser.add_argument('--cid', required=True, type=int)
    parser.add_argument('--port', default=49152, type=int)
    parser.add_argument('--control', required=True, type=Path)
    parser.add_argument('--database', required=True, type=Path)
    parser.add_argument('--max-bytes', required=True, type=int)
    parser.add_argument('--assets', type=Path)
    parser.add_argument('--listen', default='127.0.0.1:8787')
    parser.add_argument('--no-web', action='store_true')
    parser.add_argument('--output', required=True, type=Path)
    args = parser.parse_args()
    if args.max_bytes < 65536:
        parser.error('--max-bytes must be at least 65536')
    if not 3 <= args.cid <= 4294967294:
        parser.error('--cid must be between 3 and 4294967294')
    if not 1 <= args.port <= 4294967294:
        parser.error('--port must be between 1 and 4294967294')
    paths = [args.binary, args.control, args.database]
    if not args.no_web and args.assets is None:
        parser.error('--assets is required to serve the dashboard')
    if args.assets is not None:
        paths.append(args.assets)
    if any(not path.is_absolute() for path in paths):
        parser.error('deployment paths must be absolute')
    command = [args.binary, 'serve', '--cid', args.cid, '--port', args.port, '--control', args.control,
               '--database', args.database, '--max-bytes', args.max_bytes]
    if args.no_web:
        command.append('--no-web')
    else:
        command.extend(['--assets', args.assets, '--listen', args.listen])
    template = Path(__file__).resolve().parents[1] / 'debug-channel/host/systemd/venera-debug-host.service.in'
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(template.read_text().replace('@EXEC_START@', ' '.join(map(quoted, command))))
    print(args.output)


if __name__ == '__main__':
    main()
