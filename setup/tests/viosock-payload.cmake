include("${CMAKE_CURRENT_LIST_DIR}/../viosock-payload.cmake")
if(CHILD)
  viosock_payload("${PACKAGE}" files)
  list(LENGTH files count)
  if(NOT count EQUAL 9)
    message(FATAL_ERROR "Expected nine package files, got ${count}")
  endif()
  return()
endif()
set(package "${CMAKE_CURRENT_BINARY_DIR}/viosock-payload-fixture")
file(REMOVE_RECURSE "${package}")
file(MAKE_DIRECTORY "${package}")
set(names viosock.inf viosock.cat viosock.sys viosocklib_x64.dll viosocklib_x86.dll
          viosockwspsvc.exe LICENSE.txt viosock-LICENSE.txt viosock-lib-LICENSE.txt)
foreach(name IN LISTS names)
  file(WRITE "${package}/${name}" "fixture")
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" -DCHILD=ON "-DPACKAGE=${package}"
                -P "${CMAKE_CURRENT_LIST_FILE}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Complete package validation failed")
endif()
foreach(name IN LISTS names)
  file(REMOVE "${package}/${name}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -DCHILD=ON "-DPACKAGE=${package}"
                  -P "${CMAKE_CURRENT_LIST_FILE}" RESULT_VARIABLE result ERROR_VARIABLE error)
  if(result EQUAL 0 OR NOT error MATCHES "${name}[ \n\r]+is required")
    message(FATAL_ERROR "Expected a missing-file diagnostic for ${name}: ${error}")
  endif()
  file(WRITE "${package}/${name}" "fixture")
endforeach()
file(REMOVE_RECURSE "${package}")
