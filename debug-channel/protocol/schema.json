{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Venera debug message",
  "type": "object",
  "required": ["major", "type"],
  "properties": {"major": {"const": 1}},
  "oneOf": [
    {
      "properties": {"type": {"const": "system.info.get"}, "request_id": {"type": "string"}},
      "required": ["request_id"]
    },
    {
      "properties": {
        "type": {"const": "system.info.result"},
        "request_id": {"type": "string"},
        "ok": {"type": "boolean"},
        "collected_at": {"type": "string"},
        "session_id": {"$ref": "#/$defs/nullableU32"},
        "sections": {"type": "array", "items": {"$ref": "#/$defs/systemInfoSection"}},
        "error": {"$ref": "#/$defs/error"}
      },
      "required": ["request_id", "ok", "collected_at", "session_id", "sections"]
    },
    {
      "properties": {
        "type": {"const": "hello"},
        "role": {"type": "string"},
        "software_version": {"type": "string"},
        "capabilities": {"$ref": "#/$defs/strings"}
      },
      "required": ["role", "software_version", "capabilities"]
    },
    {
      "properties": {"type": {"const": "status.get"}, "request_id": {"type": "string"}},
      "required": ["request_id"]
    },
    {
      "properties": {"type": {"const": "status"}},
      "$ref": "#/$defs/status"
    },
    {
      "properties": {
        "type": {"const": "filter.set"},
        "request_id": {"type": "string"},
        "filter": {"$ref": "#/$defs/filter"},
        "duration_ms": {"$ref": "#/$defs/nullableU64"}
      },
      "required": ["request_id", "filter"]
    },
    {
      "properties": {"type": {"const": "filter.reset"}, "request_id": {"type": "string"}},
      "required": ["request_id"]
    },
    {
      "properties": {
        "type": {"const": "request.result"},
        "request_id": {"type": "string"},
        "operation": {"type": "string"},
        "ok": {"type": "boolean"},
        "revision": {"$ref": "#/$defs/nullableU64"},
        "effective_filter": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/filter"}]},
        "expires_at": {"type": ["string", "null"]},
        "forwarding_enabled": {"type": ["boolean", "null"]},
        "status": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/status"}]},
        "error": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/error"}]}
      },
      "required": ["request_id", "operation", "ok"]
    },
    {
      "properties": {
        "type": {"const": "log"},
        "stream_id": {"type": "string"},
        "seq": {"$ref": "#/$defs/decimalU64"},
        "observed_at": {"type": "string"},
        "source_time": {"type": ["string", "null"]},
        "source": {"type": "string"},
        "component": {"type": "string"},
        "level": {"type": "string"},
        "raw_level": {"type": "string"},
        "session_id": {"$ref": "#/$defs/nullableU32"},
        "process": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/process"}]},
        "tid": {"$ref": "#/$defs/nullableU32"},
        "text": {"type": "string"},
        "structured": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/structuredEvent"}]}
      },
      "required": ["stream_id", "seq", "observed_at", "source", "component", "level", "raw_level", "text"]
    },
    {
      "properties": {
        "type": {"const": "gap"},
        "stream_id": {"type": "string"},
        "reason": {"type": "string"},
        "count": {"$ref": "#/$defs/nullableU64"},
        "first_seq": {"$ref": "#/$defs/nullableU64"},
        "last_seq": {"$ref": "#/$defs/nullableU64"}
      },
      "required": ["stream_id", "reason"]
    }
  ],
  "$defs": {
    "systemInfoSection": {
      "type": "object", "required": ["title", "rows"],
      "properties": {
        "title": {"type": "string"},
        "rows": {"type": "array", "items": {
          "type": "object", "required": ["key", "value", "bad", "warning"],
          "properties": {"key": {"type": "string"}, "value": {"type": "string"}, "bad": {"type": "boolean"}, "warning": {"type": "string"}}
        }}
      }
    },
    "strings": {"type": "array", "items": {"type": "string"}},
    "u32": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "u64": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "decimalU64": {"type": "string", "maxLength": 20, "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)$(?![\\s\\S])"},
    "nullableU64": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/u64"}]},
    "nullableU32": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/u32"}]},
    "structuredEvent": {
      "type": "object",
      "required": ["provider", "event_id", "version", "boot_time_filetime", "producer_instance", "producer_sequence", "source_time_filetime", "fields"],
      "properties": {
        "provider": {"type": "string"},
        "event_id": {"type": "integer", "minimum": 0, "maximum": 65535},
        "version": {"type": "integer", "minimum": 0, "maximum": 255},
        "boot_time_filetime": {"$ref": "#/$defs/decimalU64"},
        "producer_instance": {"$ref": "#/$defs/decimalU64"},
        "producer_sequence": {"$ref": "#/$defs/decimalU64"},
        "source_time_filetime": {"$ref": "#/$defs/decimalU64"},
        "fields": {"type": "object", "additionalProperties": {"$ref": "#/$defs/eventValue"}}
      }
    },
    "eventValue": {
      "type": "object", "required": ["type", "value"],
      "oneOf": [
        {"properties": {"type": {"const": "uint8"}, "value": {"type": "integer", "minimum": 0, "maximum": 255}}},
        {"properties": {"type": {"const": "uint16"}, "value": {"type": "integer", "minimum": 0, "maximum": 65535}}},
        {"properties": {"type": {"const": "uint32"}, "value": {"$ref": "#/$defs/u32"}}},
        {"properties": {"type": {"const": "int32"}, "value": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}}},
        {"properties": {"type": {"const": "uint64"}, "value": {"$ref": "#/$defs/decimalU64"}}},
        {"properties": {"type": {"const": "ansi_string"}, "value": {"type": "string"}}}
      ]
    },
    "process": {
      "type": "object", "required": ["pid"],
      "properties": {
        "pid": {"$ref": "#/$defs/u32"},
        "start_time_filetime": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/decimalU64"}]},
        "boot_time_filetime": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/decimalU64"}]},
        "start_key": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/decimalU64"}]},
        "exe_path": {"type": ["string", "null"]}
      }
    },
    "filter": {
      "type": "object", "required": ["components", "levels", "targets"],
      "properties": {
        "components": {"$ref": "#/$defs/strings"},
        "levels": {"$ref": "#/$defs/strings"},
        "targets": {"type": "array", "items": {"oneOf": [
          {
            "type": "object", "required": ["kind", "pid", "start_time_filetime", "include_descendants"],
            "properties": {
              "kind": {"const": "process_instance"}, "pid": {"$ref": "#/$defs/u32"},
              "start_time_filetime": {"type": "string"}, "include_descendants": {"type": "boolean"},
              "boot_time_filetime": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/decimalU64"}]},
              "start_key": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/decimalU64"}]}
            }
          },
          {
            "type": "object", "required": ["kind", "path"],
            "properties": {"kind": {"const": "exe_path"}, "path": {"type": "string"}}
          }
        ]}}
      }
    },
    "status": {
      "type": "object", "required": ["forwarding_enabled", "revision", "effective_filter", "health", "loss"],
      "properties": {
        "forwarding_enabled": {"type": "boolean"}, "revision": {"$ref": "#/$defs/u64"},
        "effective_filter": {"$ref": "#/$defs/filter"}, "expires_at": {"type": ["string", "null"]},
        "health": {}, "loss": {}
      }
    },
    "error": {
      "type": "object", "required": ["code", "message"],
      "properties": {"code": {"type": "string"}, "message": {"type": "string"}}
    }
  }
}
