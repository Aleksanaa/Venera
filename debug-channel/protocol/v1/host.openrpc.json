{
  "openrpc": "1.4.1",
  "info": {
    "title": "Venera host",
    "version": "1.0.0"
  },
  "methods": [
    {
      "name": "endpoint.info",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "result",
        "schema": {
          "$ref": "#/components/schemas/OutputEndpointInfo"
        }
      }
    },
    {
      "name": "rpc.discover",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "result",
        "schema": {
          "$ref": "#/components/schemas/OutputDiscovery"
        }
      }
    },
    {
      "name": "status.changed",
      "paramStructure": "by-name",
      "params": [
