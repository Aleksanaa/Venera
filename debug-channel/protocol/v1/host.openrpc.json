          "required": true,
          "schema": {
            "type": "boolean"
          }
        },
        {
          "name": "health",
          "required": true,
          "schema": true
        },
        {
          "name": "loss",
          "required": true,
          "schema": true
        },
        {
          "name": "revision",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/InputDecimalU64"
          }
        },
        {
          "name": "expires_at",
          "required": false,
          "schema": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      ]
    },
    {
      "name": "log",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "component",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "level",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "observed_at",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "raw_level",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "seq",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/InputDecimalU64"
          }
        },
        {
          "name": "source",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "stream_id",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
