          "name",
          "paramStructure",
          "params"
        ],
        "type": "object"
      },
      "OutputParamStructure": {
        "enum": [
          "by-name"
        ],
        "type": "string"
      },
      "OutputStatus": {
        "properties": {
          "effective_filter": {
            "$ref": "#/components/schemas/OutputFilter"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ]
