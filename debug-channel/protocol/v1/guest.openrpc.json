            "type": "array"
          },
          "openrpc": {
            "type": "string"
          }
        },
        "required": [
          "openrpc",
          "info",
          "methods",
          "components"
        ],
        "type": "object"
      },
      "OutputDiscoveryComponents": {
        "properties": {
          "schemas": {
            "additionalProperties": true,
            "type": "object"
          }
        },
        "required": [
          "schemas"
        ],
        "type": "object"
      },
      "OutputDiscoveryInfo": {
        "properties": {
          "title": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "version"
        ],
        "type": "object"
      },
      "OutputEndpointInfo": {
        "properties": {
          "protocol_version": {
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$(?![\\s\\S])",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/OutputEndpointRole"
          },
          "software_version": {
            "type": "string"
          }
        },
        "required": [
          "role",
          "software_version",
          "protocol_version"
