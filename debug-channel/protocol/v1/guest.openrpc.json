  "components": {
    "schemas": {
      "InputDecimalU64": {
        "maxLength": 20,
        "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)$(?![\\s\\S])",
        "type": "string"
      },
      "InputEmpty": {
        "type": "object"
      },
      "InputFilter": {
        "properties": {
          "components": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "levels": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "targets": {
            "items": {
              "$ref": "#/components/schemas/InputTarget"
            },
            "type": "array"
          }
        },
        "required": [
          "components",
          "levels",
          "targets"
        ],
        "type": "object"
      },
      "InputFilterSet": {
        "properties": {
          "duration_ms": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/InputDecimalU64"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "filter": {
            "$ref": "#/components/schemas/InputFilter"
          }
        },
        "required": [
          "filter"
        ],
        "type": "object"
      },
      "InputTarget": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "include_descendants": {
                "type": "boolean"
              },
              "kind": {
                "const": "process_instance",
                "type": "string"
              },
              "pid": {
                "maximum": 4294967295,
                "minimum": 0,
                "type": "integer"
              },
              "start_time_filetime": {
                "$ref": "#/components/schemas/InputDecimalU64"
              }
            },
            "required": [
              "kind",
              "pid",
              "start_time_filetime",
              "include_descendants"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "exe_path",
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "path"
            ],
            "type": "object"
          }
        ]
      },
      "OutputContentDescriptor": {
        "properties": {
          "name": {
            "type": "string"
          },
          "required": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "schema": true
        },
        "required": [
          "name",
          "schema"
        ],
        "type": "object"
      },
      "OutputDecimalU64": {
        "maxLength": 20,
        "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)$(?![\\s\\S])",
        "type": "string"
      },
      "OutputDiscovery": {
        "description": "The discovery document returned by the connected receiver.",
        "properties": {
          "components": {
            "$ref": "#/components/schemas/OutputDiscoveryComponents"
          },
          "info": {
            "$ref": "#/components/schemas/OutputDiscoveryInfo"
          },
          "methods": {
            "items": {
              "$ref": "#/components/schemas/OutputMethodDescriptor"
