          "forwarding_enabled": {
            "type": "boolean"
          },
          "health": true,
          "loss": true,
          "revision": {
            "$ref": "#/components/schemas/OutputDecimalU64"
          }
        },
        "required": [
          "forwarding_enabled",
          "revision",
          "effective_filter",
          "expires_at",
          "health",
          "loss"
        ],
        "type": "object"
      },
      "OutputSystemInfo": {
        "properties": {
          "collected_at": {
            "type": "string"
          },
          "sections": {
            "items": {
              "$ref": "#/components/schemas/OutputSystemInfoSection"
            },
            "type": "array"
          },
          "session_id": {
            "maximum": 4294967295,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "collected_at",
          "session_id",
          "sections"
        ],
        "type": "object"
      },
      "OutputSystemInfoRow": {
        "properties": {
          "bad": {
            "type": "boolean"
          },
          "key": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "warning": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "value",
          "bad",
          "warning"
        ],
        "type": "object"
      },
      "OutputSystemInfoSection": {
        "properties": {
          "rows": {
            "items": {
              "$ref": "#/components/schemas/OutputSystemInfoRow"
