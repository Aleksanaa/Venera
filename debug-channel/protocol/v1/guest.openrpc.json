            "default": null
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "$ref": "#/components/schemas/OutputStatus"
        }
      }
    },
    {
      "name": "filter.reset",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "result",
        "schema": {
          "$ref": "#/components/schemas/OutputStatus"
        }
      }
    },
    {
      "name": "system.info.get",
      "paramStructure": "by-name",
      "params": [],
      "result": {
