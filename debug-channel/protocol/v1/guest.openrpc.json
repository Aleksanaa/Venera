          "$ref": "#/components/schemas/OutputEndpointInfo"
        }
      }
    },
    {
      "name": "status.get",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "result",
        "schema": {
          "$ref": "#/components/schemas/OutputStatus"
        }
      }
    },
