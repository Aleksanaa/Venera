            "type": "string"
          }
        },
        "required": [
          "title",
          "rows"
        ],
        "type": "object"
      },
      "OutputTarget": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "include_descendants": {
                "type": "boolean"
              },
              "kind": {
                "const": "process_instance",
                "type": "string"
              },
              "pid": {
                "maximum": 4294967295,
                "minimum": 0,
                "type": "integer"
              },
              "start_time_filetime": {
                "$ref": "#/components/schemas/OutputDecimalU64"
