+static int
+wsi_win32_present_thread(void *data)
+{
+   struct wsi_win32_swapchain *chain = (struct wsi_win32_swapchain *)data;
+   const uint32_t queue_size = ARRAY_SIZE(chain->present_queue);
+
+   u_thread_setname("wsi_win32_present");
+   mtx_lock(&chain->acquire_mutex);
+   for (;;) {
+      while (chain->present_head == chain->present_tail &&
+             !chain->present_thread_quit)
+         u_cnd_monotonic_wait(&chain->present_cond, &chain->acquire_mutex);
+      if (chain->present_head == chain->present_tail)
+         break; /* quit, and nothing left to present */
+
+      const uint32_t index =
+         chain->present_queue[chain->present_head++ % queue_size];
+      mtx_unlock(&chain->acquire_mutex);
+      /* Marks the image idle (and records a failure in chain->status). */
+      wsi_win32_present_dxgi_shared_now(chain, &chain->images[index], index,
+                                        NULL);
+      mtx_lock(&chain->acquire_mutex);
+   }
+   mtx_unlock(&chain->acquire_mutex);
+   return 0;
+}
+
+/* The CPU wait for the frame plus the D3D11 copy and present took about
+ * 1.9 ms per frame on top of the GPU time, serialized with the application
+ * (Windows guest, renner-bench: 53% of native, 2026-11-15). The present
+ * thread overlaps them with the application's next frame; presents keep
+ * their order, and a queued image is not acquirable until it was presented.
+ */
+static VkResult
+wsi_win32_queue_present_dxgi_shared(struct wsi_win32_swapchain *chain,
+                                    struct wsi_win32_image *image,
+                                    uint32_t image_index,
+                                    const VkPresentRegionKHR *damage)
+{
+   if (!chain->present_thread_running)
+      return wsi_win32_present_dxgi_shared_now(chain, image, image_index,
+                                               damage);
+
+   const uint32_t queue_size = ARRAY_SIZE(chain->present_queue);
+   mtx_lock(&chain->acquire_mutex);
+   const VkResult status = chain->status;
+   if (status < VK_SUCCESS) {
+      image->state = WSI_IMAGE_IDLE;
+      u_cnd_monotonic_broadcast(&chain->acquire_cond);
+      mtx_unlock(&chain->acquire_mutex);
+      return status;
+   }
+   assert(chain->present_tail - chain->present_head < queue_size);
+   image->state = WSI_IMAGE_QUEUED;
+   chain->present_queue[chain->present_tail++ % queue_size] = image_index;
+   u_cnd_monotonic_broadcast(&chain->present_cond);
+   mtx_unlock(&chain->acquire_mutex);
+   return status;
+}
+
+static void
+wsi_win32_start_present_thread(struct wsi_win32_swapchain *chain)
+{
+   if (u_cnd_monotonic_init(&chain->present_cond) != thrd_success)
+      return;
+   chain->present_head = chain->present_tail = 0;
+   chain->present_thread_quit = false;
+   if (thrd_create(&chain->present_thread, wsi_win32_present_thread, chain) !=
+       thrd_success) {
+      u_cnd_monotonic_destroy(&chain->present_cond);
+      mesa_logw("wsi/win32: no present thread; presenting inline");
+      return;
+   }
+   chain->present_thread_running = true;
+}
+
+/* Presents what is queued, then ends the thread. */
+static void
+wsi_win32_stop_present_thread(struct wsi_win32_swapchain *chain)
+{
+   if (!chain->present_thread_running)
+      return;
+   mtx_lock(&chain->acquire_mutex);
+   chain->present_thread_quit = true;
+   u_cnd_monotonic_broadcast(&chain->present_cond);
+   mtx_unlock(&chain->acquire_mutex);
+   thrd_join(chain->present_thread, NULL);
+   u_cnd_monotonic_destroy(&chain->present_cond);
+   chain->present_thread_running = false;
+}
 #endif
 
 static VkResult
