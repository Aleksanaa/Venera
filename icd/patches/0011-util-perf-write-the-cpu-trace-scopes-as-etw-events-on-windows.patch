diff -ruN a/src/util/perf/u_etw.c b/src/util/perf/u_etw.c
--- a/src/util/perf/u_etw.c	1970-01-01 08:00:00.000000000 +0800
+++ b/src/util/perf/u_etw.c	2026-11-11 17:04:02.116984196 +0800
@@ -0,0 +1,78 @@
+/*
+ * Copyright 2026 Venera contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "u_etw.h"
+
+#include <windows.h>
+
+#include <evntprov.h>
+#include <evntrace.h>
+#include <string.h>
+
+bool util_etw_enabled;
+
+static const GUID provider = {
+   0x6ceeacf1, 0xf746, 0x4fe6, {0xbf, 0xf7, 0xa5, 0x96, 0xfe, 0xde, 0x9b, 0x4e}};
+
+static REGHANDLE handle;
+
+static void NTAPI
+on_enable(LPCGUID source, ULONG is_enabled, UCHAR level, ULONGLONG any,
+          ULONGLONG all, PEVENT_FILTER_DESCRIPTOR filter, PVOID context)
+{
+   /* a state capture leaves the provider enabled */
+   if (is_enabled != EVENT_CONTROL_CODE_CAPTURE_STATE)
+      p_atomic_set(&util_etw_enabled,
+                   is_enabled != EVENT_CONTROL_CODE_DISABLE_PROVIDER);
+}
+
+/* For the module's lifetime: ETW calls on_enable, so the registration must
+ * be gone before the module unloads.
+ */
+__attribute__((constructor)) static void
+util_etw_register(void)
+{
+   EventRegister(&provider, on_enable, NULL, &handle);
+}
+
+__attribute__((destructor)) static void
+util_etw_unregister(void)
+{
+   p_atomic_set(&util_etw_enabled, false);
+   EventUnregister(handle);
+}
+
+static void
+write_event(USHORT id, ULONG count, EVENT_DATA_DESCRIPTOR *data)
+{
+   EVENT_DESCRIPTOR d;
+   EventDescCreate(&d, id, 0, 0, 4 /* information */, 0, 0, 0);
+   EventWrite(handle, &d, count, data);
+}
+
+void
+util_etw_begin(const char *name)
+{
+   const uint64_t value = 0;
+   EVENT_DATA_DESCRIPTOR d[2];
+   EventDataDescCreate(&d[0], name, strlen(name) + 1);
+   EventDataDescCreate(&d[1], &value, sizeof(value));
+   write_event(1, 2, d);
+}
+
+void
+util_etw_end(void)
+{
+   write_event(2, 0, NULL);
+}
+
+void
+util_etw_counter(const char *name, int64_t value)
+{
+   EVENT_DATA_DESCRIPTOR d[2];
+   EventDataDescCreate(&d[0], name, strlen(name) + 1);
+   EventDataDescCreate(&d[1], &value, sizeof(value));
+   write_event(4, 2, d);
+}
diff -ruN a/src/util/perf/u_etw.h b/src/util/perf/u_etw.h
--- a/src/util/perf/u_etw.h	1970-01-01 08:00:00.000000000 +0800
+++ b/src/util/perf/u_etw.h	2026-11-11 17:03:54.673917165 +0800
@@ -0,0 +1,44 @@
+/*
+ * Copyright 2026 Venera contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/* Mesa's CPU trace scopes as ETW events on Windows, through Venera's
+ * provider {6ceeacf1-f746-4fe6-bff7-a596fede9b4e}: begin (id 1: name, u64
+ * value), end (id 2) and counter (id 4: name, i64 value), in the layout
+ * Venera's UMDs write (umd/common/trace.h).
+ */
+
+#ifndef U_ETW_H
+#define U_ETW_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "util/u_atomic.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#ifdef HAVE_ETW
+
+extern bool util_etw_enabled;
+
+static inline bool
+util_etw_is_enabled(void)
+{
+   return p_atomic_read_relaxed(&util_etw_enabled);
+}
+
+void util_etw_begin(const char *name);
+void util_etw_end(void);
+void util_etw_counter(const char *name, int64_t value);
+
+#endif /* HAVE_ETW */
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* U_ETW_H */
